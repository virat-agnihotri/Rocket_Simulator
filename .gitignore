.env
.env.*
!.env.example
*.pem
*.key

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- HEAVY 3D ASSETS ----------
# Exclude large rocket and Earth models
*.glb
*.gltf
*.fbx
*.blend
*.obj
*.stl
*.usd
*.usdz

# Exclude asset-specific directories
assets/
downloads/
frontend/public/models/
frontend/public/textures/
frontend/src/assets/models/
frontend/src/assets/textures/

# ---------- LARGE TEXTURES ----------
# Keep ordinary UI PNG/JPG images tracked.
# Exclude high-resolution texture formats.
*.exr
*.hdr
*.tif
*.tiff
*.ktx
*.ktx2

# ---------- ARCHIVES ----------
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# ---------- DATABASE ----------
*.sqlite3
*.db

# ---------- LOGS / TEMP ----------
*.log
logs/
tmp/
temp/
*.tmp

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- SIMULATION OUTPUT ----------
# Ignore generated simulation data,
# not source code or configuration.
simulation_outputs/
backend/outputs/
backend/results/
checkpoints/